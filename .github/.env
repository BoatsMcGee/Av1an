# Central, changeable values for the CI/CD scripts.
#
# The Docker image and the release-staging scripts read this file so the pins
# they build cannot drift apart. Keep a value here when more than one of them
# needs it; anything used in only one place stays with that script.
#
# The av-metrics-*/scripts/ installers are standalone and never read this file.
# They keep the same values as their own defaults and accept them as environment
# overrides, which is how the staging scripts pass these pins down.

# libvship: built from the release tag VSHIP_VERSION, whose commit is verified.
VSHIP_VERSION=v5.1.2
VSHIP_COMMIT=5a627933274196219f782b3b74e13fad47cd6370
VSHIP_REPO=https://codeberg.org/Line-fr/Vship.git

# fmetrics: built from the branch FMETRICS_BRANCH, whose head commit is verified.
FMETRICS_COMMIT=ae87c8e5607063f0dcc8241b52cb143f6c9ad4ac
FMETRICS_REPO=https://github.com/BoatsMcGee/fmetrics.git
FMETRICS_BRANCH=add-windows-shared-build
# The fork's merge-base in halidecx/fmetrics; the Windows install asserts on it.
FMETRICS_UPSTREAM_BASE=e8bf3cfe06fb78f51864804b2f7003667d4c5a71

# libvmaf: release the Windows installer and the staging script fetch.
VMAF_VERSION=3.2.1
