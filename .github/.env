# TransNetV2: ONNX export of the soCzech/TransNetV2 scene boundary network
# (elya5/transnetv2 on Hugging Face). The staging scripts place it in model/
# beside the executable; the andean-condor/scripts/ installers keep the same
# values as their own standalone defaults.
TRANSNETV2_MODEL_URL=https://huggingface.co/elya5/transnetv2/resolve/main/transnetv2.onnx
